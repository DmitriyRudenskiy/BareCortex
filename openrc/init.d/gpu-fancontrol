#!/sbin/openrc-run
# OpenRC init script for GPU fan control
# BareCortex - Bare-metal AI compute OS
#
# The write itself belongs to `bmc-fan`, which reports per device whether the
# driver accepted it. That is the whole reason this is a wrapper: `nvidia-smi -f`
# is unsupported on most GeForce and many Quadro cards, and the previous
# version piped its stderr to /dev/null behind `|| true`, so the service
# reported a successful start on cards where nothing had changed.
#
# There is no temperature loop and no threshold here. `gpu-stack` 7.1-7.3 owns
# those decisions (input field, interval, and the state the fans park in when
# the read fails), and a cooling policy is not something a wrapper invents.
#
# Persistence mode is not set here either: this service already declares
# `need nvidia-persistenced`, and `nvidia-smi -pm 1` beside a running daemon is
# a second mechanism for one job.

name="GPU Fan Control"
description="Sets GPU fan speeds through bmc-fan and reports what the driver accepted"

FAN_SPEED="${FAN_SPEED:-80}"
LOG_FILE="${LOG_FILE:-/var/log/gpu-fancontrol.log}"

pidfile="/run/gpu-fancontrol.pid"

depend() {
    need nvidia-persistenced
}

start() {
    ebegin "Starting ${name} (target: ${FAN_SPEED}%)"

    # bmc-fan exits 0 only when every device accepted the write, and names the
    # driver's own reason when one did not.
    bmc-fan --percent "${FAN_SPEED}"
    local rc=$?
    echo "$(date): fan control start requested at ${FAN_SPEED}%, bmc-fan exit ${rc}" >> "${LOG_FILE}"
    eend ${rc}
}

stop() {
    ebegin "Stopping ${name} (returning control to the driver)"

    # 0 is the write that returns the card to its own thermal curve — the same
    # write the previous stop() made, now with a reported result.
    bmc-fan --percent 0
    local rc=$?
    echo "$(date): fan control stop, bmc-fan exit ${rc}" >> "${LOG_FILE}"
    eend ${rc}
}
