# Configuration for AI Training Service
# BareCortex

# Path to your training script
TRAINING_SCRIPT="/opt/ai/train.py"

# Path to Python binary in your venv
PYTHON_BIN="/opt/ai/venv/bin/python"

# Comma-separated list of GPU IDs to use
# Examples: "0", "0,1", "0,1,2,3"
GPU_IDS="0,1"

# Log directory
LOG_DIR="/var/log/ai-training"

# Additional environment variables
# export CUDA_VISIBLE_DEVICES="0,1"
# export OMP_NUM_THREADS=16
# NCCL environment does not live here: it is sourced from /etc/conf.d/nccl
# (see openrc/conf.d/nccl) so every consumer resolves the same values.
