# BareCortex Kernel Configuration
# Optimized for AI/ML workloads on multi-GPU NVIDIA servers
# Based on Linux 6.12+
#
# NOTE: this is a FRAGMENT of the AI-relevant options, not a complete .config.
# Run `make olddefconfig` against a base config (e.g. the LFS kernel config)
# to fill in the rest, then diff before shipping.
#
# NOTE: the NVIDIA *proprietary* driver is not a Kconfig target. It builds
# out-of-tree from the .run/tarball (see GLFS). The DRM symbols below apply
# only to the in-tree driver; keep them if you use nouveau, drop them if you
# use the proprietary stack exclusively.

#
# Processor type and features
#
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_NUMA=y
CONFIG_PREEMPT_NONE=y
CONFIG_HZ_300=y
CONFIG_HPET_TIMER=y

#
# Memory Management
#
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_CMA=y

#
# Bus options (PCI)
#
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_IOV=y
CONFIG_PCI_PASID=y
CONFIG_PCIEAER=y
CONFIG_PCIEASPM=y
# Disable ASPM for stability under heavy GPU load
# CONFIG_PCIEASPM_DEFAULT is not set
CONFIG_PCIEASPM_PERFORMANCE=y
CONFIG_PCI_REALLOC_ENABLE_AUTO=y
CONFIG_PCI_STUB=y

#
# IOMMU support
#
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y

#
# NVIDIA GPU support (in-tree driver only — see note at top)
#
CONFIG_DRM=y
CONFIG_DRM_NVIDIA=m
# Enable NVIDIA DRM kernel modesetting (required for Wayland/Xorg)
CONFIG_DRM_NVIDIA_MODESET=y

#
# Network support (for distributed training)
#
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_NETFILTER=y

#
# File systems
#
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_TMPFS=y
CONFIG_HUGETLBFS=y

#
# Performance monitoring
#
CONFIG_PERF_EVENTS=y
CONFIG_PROFILING=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
